<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      .NET Framework 4.8 target. On the desktop CLR, Excel-DNA loads the managed
      add-in in-process and does NOT extract a .NET host DLL to %TEMP%, so it
      sidesteps the Defender ASR rule (3B576869-...) that blocks the .NET 8 host.
    -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>PExL.AddIn</RootNamespace>
    <AssemblyName>PExL.AddIn</AssemblyName>
    <ExcelAddInFileName>PExL</ExcelAddInFileName>

    <!--
      Emit PExL.AddIn.deps.json. .NET Framework projects don't generate it by
      default, but ExcelDnaPack reads it to discover and EMBED managed
      dependencies (PExL.Core, Newtonsoft.Json, WebView2 managed) into the packed
      .xll. Without it, only PExL.AddIn is packed and PExL.Core fails to load.
    -->
    <GenerateDependencyFile>true</GenerateDependencyFile>

    <!--
      Only methods marked [ExcelFunction]/[ExcelCommand] are registered. This
      add-in exposes no UDFs (it's ribbon + task pane), so this stops Excel-DNA
      from scanning helper classes (ExcelInjector, GlobalStore, …) as worksheet
      functions — which caused "Repeated function name: 'Create'" and spurious
      PExL.Core load attempts during registration.
    -->
    <ExcelAddInExplicitExports>true</ExcelAddInExplicitExports>

    <!--
      Keep the native WebView2Loader.dll as a LOOSE file beside the .xll (copied
      by the CopyWebView2Loader target below) instead of embedding it. Embedding
      native deps would extract them to %TEMP% at load, re-tripping the Defender
      ASR rule that the net48 target exists to avoid.
    -->
    <ExcelDnaPackNativeLibraryDependencies>false</ExcelDnaPackNativeLibraryDependencies>
  </PropertyGroup>

  <!-- WinForms framework references (reliable way to enable WinForms on net48 SDK-style). -->
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <!-- Required for C# 'dynamic' (late-bound COM) on the desktop CLR. -->
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ExcelDna.AddIn" Version="1.9.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PExL.Core\PExL.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Editor web assets are copied next to the .xll so WebView2 can load them locally. -->
    <None Include="..\PExL.Editor.Web\**\*.*" Link="web\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Drop the native WebView2 loader beside the .xll as a loose file. It is never
    embedded by ExcelDnaPack (native), and loading a loose DLL does not trip the
    ASR "create executable content in temp" rule the way the .NET host did.
  -->
  <Target Name="CopyWebView2Loader" AfterTargets="Build">
    <ItemGroup>
      <_Wv2Loader Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_Wv2Loader)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true"
          Condition="Exists('$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll')" />
  </Target>

</Project>
