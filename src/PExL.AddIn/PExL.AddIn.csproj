<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      .NET Framework 4.8 target. On the desktop CLR, Excel-DNA loads the managed
      add-in in-process and does NOT extract a .NET host DLL to %TEMP%, so it
      sidesteps the Defender ASR rule (3B576869-...) that blocks the .NET 8 host.
    -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>PExL.AddIn</RootNamespace>
    <AssemblyName>PExL.AddIn</AssemblyName>
    <ExcelAddInFileName>PExL</ExcelAddInFileName>
  </PropertyGroup>

  <!-- WinForms framework references (reliable way to enable WinForms on net48 SDK-style). -->
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <!-- Required for C# 'dynamic' (late-bound COM) on the desktop CLR. -->
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ExcelDna.AddIn" Version="1.9.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PExL.Core\PExL.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Editor web assets are copied next to the .xll so WebView2 can load them locally. -->
    <None Include="..\PExL.Editor.Web\**\*.*" Link="web\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Drop the native WebView2 loader beside the .xll as a loose file. It is never
    embedded by ExcelDnaPack (native), and loading a loose DLL does not trip the
    ASR "create executable content in temp" rule the way the .NET host did.
  -->
  <Target Name="CopyWebView2Loader" AfterTargets="Build">
    <ItemGroup>
      <_Wv2Loader Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_Wv2Loader)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true"
          Condition="Exists('$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll')" />
  </Target>

</Project>
